# Base application URL and deploy settings
app.base-url=http://localhost:8080/PetShop
app.context-path=/PetShop
app.cookies.secure=false
deploy.tomcat-home=
app.cookies.secure=false
app.static.cache.max-age-seconds=86400

# Checkout client config
api.provinces.base-url=https://provinces.open-api.vn/api/v1
payment.bank.pending-minutes=10

# Bank transfer display config
payment.bank.id=VPB
payment.bank.account-number=0368600557
payment.bank.account-name=NGUYEN HUU THANH
payment.bank.display-name=VP Bank
payment.bank.transfer-prefix=PETSHOP
payment.bank.currency=VND

# Future bank verification integration placeholders
payment.bank.verification-mode=stub
payment.bank.api-base-url=
payment.bank.api-key=
payment.bank.api-secret=
payment.bank.webhook-secret=change-me-in-production

# MoMo placeholders
payment.momo.mode=demo
payment.momo.partner-code=
payment.momo.access-key=
payment.momo.secret-key=

# Rate-limit defaults (requests per minute)
ratelimit.login=10
ratelimit.register=6
ratelimit.forgot-password=6
ratelimit.checkout=8
ratelimit.bank-webhook=60
ratelimit.add-review=5
ratelimit.search-autocomplete=8
