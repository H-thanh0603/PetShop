# Secrets & environment for docker compose (copy to .env and fill in).
# NEVER commit the real .env file.

MYSQL_ROOT_PASSWORD=change-me-strong
DB_PASSWORD=change-me-strong

APP_BASE_URL=https://melipet.shop

# Payments
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
PAYMENT_BANK_ID=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_WEBHOOK_SECRET=generate-a-long-random-secret
PAYMENT_GHN_WEBHOOK_SECRET=generate-a-long-random-secret

# Shipping (GHN)
GHN_TOKEN=
GHN_ORDER_TOKEN=

# AI (provider-agnostic — set only the provider you use; see docs/commerce-agent.md)
AI_PROVIDER=deepseek
AI_MODEL=
AI_FALLBACKS=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOKENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Monitoring
GRAFANA_ADMIN_PASSWORD=change-me-strong
